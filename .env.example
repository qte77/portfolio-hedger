# Copy to .env (gitignored). Used only by `make deploy`. The name must be CLOUDFLARE_API_TOKEN
# (wrangler treats CLOUDFLARE_API_KEY as a Global API Key, which also needs CLOUDFLARE_EMAIL).
# Account API token: dash.cloudflare.com > Manage account > API tokens > Create token >
# Custom token, permission Account | Cloudflare Pages | Edit, scoped to this account.
CLOUDFLARE_API_TOKEN=
# Account ID (not a secret): dashboard > Account home > Account details, or `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=
